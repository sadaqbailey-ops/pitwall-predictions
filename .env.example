# Postgres (Neon). `neon env pull` fills these in for you.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=

# Google OAuth client. Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
